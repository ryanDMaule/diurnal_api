{
  "name": "diurnal_api",
  "version": "1.0.0",
  "description": "API for Diurnal — a daily vocabulary app delivering one word each day.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "catalogue:build": "node scripts/catalogue.js build",
    "catalogue:parse": "node scripts/catalogue.js parse",
    "catalogue:validate": "node scripts/catalogue.js validate",
    "catalogue:shuffle": "node scripts/catalogue.js shuffle",
    "catalogue:verify": "node scripts/catalogue.js verify",
    "catalogue:report": "node scripts/catalogue.js report"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "author": "Ryan Maule",
  "license": "MIT"
}
